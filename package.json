{
  "name": "offline-video-encoding-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ffmpeg-core.mjs && vite --host 0.0.0.0 --port 5173",
    "build": "vue-tsc -b && node scripts/copy-ffmpeg-core.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "vue-tsc -b",
    "postinstall": "node scripts/copy-ffmpeg-core.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fluentui/web-components": "^2.6.1",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.3"
  }
}
